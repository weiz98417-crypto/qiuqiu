APP_ENV=development
APP_TOKEN=
# Optional second director-console password.
APP_TOKEN_SECONDARY=
AUTH_MODE=dual
# ADR-0010 console JWT login secret (required once any operator password
# account exists; 32+ random chars).
QIUQIU_JWT_SECRET=
SESSION_SIGNING_KEY=
ALLOWED_ORIGINS=http://localhost:7357
POSTGRES_PASSWORD=
# Local durable mode (the PostgreSQL server must have pgvector installed):
# DATABASE_URL=postgres://qiuqiu:your-password@localhost:5432/qiuqiu?sslmode=disable
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_VOICE=冰糖
COMPANION_REALIZER_TIMEOUT_MS=5000
APISPORTS_API_KEY=
APISPORTS_BASE_URL=https://v3.football.api-sports.io
PRIVACY_RETENTION_DAYS=30
FACT_LEDGER_PUBLIC_READS=true
REDIS_ADDR=localhost:6379
PORT=8080

# 语义记忆双路（openspec/changes/semantic-memory）：留空即停用（现状
# contains 单路）。本地 Ollama bge-m3：ollama pull bge-m3 && ollama serve
# （OLLAMA_MODELS=D:\ollama\models）。
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3

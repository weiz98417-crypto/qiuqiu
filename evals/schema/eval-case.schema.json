{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QiuQiu versioned evaluation case",
  "type": "object",
  "required": ["version", "id", "suite", "summary", "config"],
  "properties": {
    "version": {"const": "2026-07"},
    "id": {"type": "string", "pattern": "^(baseline|boundary|regression)\\.[a-z0-9-]+$"},
    "suite": {"enum": ["baseline", "boundary", "regression"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "config": {"type": "object", "required": ["homeTeam", "awayTeam"]},
    "events": {"type": "array"},
    "turns": {"type": "array"},
    "final": {"type": "object"}
  },
  "additionalProperties": false
}

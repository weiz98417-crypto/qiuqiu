# docker-compose.yml 所需的环境变量全集（cp .env.example .env 后逐项填写）。
# 本地直接 go run 的开发配置见 backend/.env.example（两者用途不同，勿混用）。

# ── 必填（compose 中以 :? 声明，缺一不可启动）──────────────────────────

# 机器通道口令：评测/脚本用 Bearer 令牌（人用控制台走用户名 + 密码 JWT 登录）。
APP_TOKEN=
# 用户会话签名密钥（32 位以上随机串）。
SESSION_SIGNING_KEY=
# 用户端与企业控制台的允许来源（逗号分隔，如 https://qiuqiu.example.com）。
ALLOWED_ORIGINS=
# 主库（pgvector/pgvector:pg16）强密码。
POSTGRES_PASSWORD=
# 对话 / ASR / TTS 统一密钥（Memobase 的抽取 LLM 也复用它）。
MIMO_API_KEY=
# Memobase 专用 Postgres 强密码（不与主库共用）。
MEMOBASE_POSTGRES_PASSWORD=

# ── 条件必填 ──────────────────────────────────────────────────────────

# ADR-0010 控制台 JWT 登录签名密钥（32 位以上随机串）：
# 只要存在任何密码账号就必须配置，否则控制台登录会拒绝。
QIUQIU_JWT_SECRET=

# ── 可选（有默认值，按需覆盖）──────────────────────────────────────────

# 第二个导播台口令（可选）。
APP_TOKEN_SECONDARY=
# 宿主机映射端口（默认 8080）。
# PORT=8080
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_VOICE=冰糖
# COMPANION_REALIZER_TIMEOUT_MS=5000
# 外部足球数据源密钥（留空则只用导播/自动化数据）。
# APISPORTS_API_KEY=
# APISPORTS_BASE_URL=https://v3.football.api-sports.io
# 隐私保留天数（默认 30）。
# PRIVACY_RETENTION_DAYS=30
# 直播延迟事实协调开关（默认 true）。
# PENDING_OBSERVATION_COORDINATION=true
# 事实账本公共读开关（默认 true；设为 false 回退旧投影）。
# FACT_LEDGER_PUBLIC_READS=true
# MEMOBASE_URL=http://memobase:8000
# MEMOBASE_TOKEN=secret
# MEMOBASE_EXTRACTION_TIMEOUT_MS=10000

# 语义记忆（openspec/changes/memory-into-turns 独立任务 A）：默认关。
# 本地方案（用户裁决）：宿主机跑 Ollama + bge-m3（OLLAMA_MODELS=D:\ollama\models，
# `ollama pull bge-m3` 后 `ollama serve`），容器经 host.docker.internal 访问。
# 开关翻 true 即启用 Memobase 服务端 bge-m3 嵌入；不开启则现状关键词召回
# 照旧。存量记忆无向量，仅新写入生效。
# MEMOBASE_ENABLE_EVENT_EMBEDDING=true
# MEMOBASE_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# MEMOBASE_EMBEDDING_MODEL=bge-m3

# 召回时序衰减（memory-recall-fusion）：向量路按 cosine×exp(-age/τ) 重排，
# 天数 ≤0 关闭；默认 14。
# RECALL_DECAY_DAYS=14
# MEMOBASE_EMBEDDING_DIM=1024
